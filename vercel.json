{
  "name": "hospital-management-system",
  "buildCommand": "npm run build -- --configuration production --output-path dist/Frontend",
  "outputDirectory": "dist/Frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
